# 生产环境配置 — 部署时复制为 backend/.env
# 因为已移除 token 认证，ACCESS_TOKEN 保留占位即可
ACCESS_TOKEN=yang
# 数据库存放路径（使用绝对路径）
DB_PATH=/home/kebiao/data/app.db
TIMEZONE=Asia/Shanghai
# CORS 允许的前端地址（逗号分隔，多个地址写多个）
# 如果有域名: https://your-domain.com
# 如果只用 IP: http://你的公网IP
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO
